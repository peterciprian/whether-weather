# Másold .env néven, és töltsd ki. Üres kulcs = a szolgáltató ki van kapcsolva.
PORT=3000
HOST=0.0.0.0

# Kapcsolattartási adat a User-Agent fejlécben (a MET Norway feltételei kérik), pl. e-mail vagy weboldal
CONTACT=you@example.com

# Opcionális: csak ezek a szolgáltatók legyenek aktívak (vesszővel elválasztva)
# PROVIDERS=open-meteo,met-norway,weatherapi,openweather,visual-crossing,meteosource,tomorrow

# https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=
# https://home.openweathermap.org/users/sign_up
OPENWEATHER_KEY=
# https://www.visualcrossing.com/sign-up
VISUALCROSSING_KEY=
# https://www.meteosource.com/client/sign-up
METEOSOURCE_KEY=
# https://app.tomorrow.io/signup
TOMORROW_KEY=
